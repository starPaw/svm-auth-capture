{
  "name": "svm-auth-capture-x402",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SAC-004: minimal x402 v2 auth-capture facilitator for the SVM Auth-Capture program",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "devnet": "node --experimental-strip-types src/devnet-server.ts",
    "restaurant": "node --experimental-strip-types src/restaurant-server.ts",
    "devnet:resource": "node --experimental-strip-types src/devnet-resource-server.ts",
    "devnet:client": "node --experimental-strip-types src/client.ts",
    "devnet:reclaim": "node --experimental-strip-types src/reclaim.ts",
    "devnet:reconcile": "node --experimental-strip-types src/reconcile.ts",
    "build:wallet": "node browser/build.mjs",
    "restaurant:outcome": "node --experimental-strip-types src/restaurant-outcome.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.4.0",
    "fs-ext": "2.1.1",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@solana/web3.js": "1.98.4",
    "@solflare-wallet/sdk": "1.4.2",
    "@types/fs-ext": "2.0.3",
    "@types/node": "26.6.4",
    "esbuild": "0.27.4",
    "litesvm": "1.5.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
