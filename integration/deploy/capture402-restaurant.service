[Unit]
Description=Capture402 restaurant application
After=network-online.target capture402-facilitator.service

[Service]
Type=simple
User=sac006
Group=sac006
WorkingDirectory=/opt/capture402/current/integration
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/sac006/resource.env
ExecStart=/usr/bin/env node --experimental-strip-types src/restaurant-server.ts
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sac006

[Install]
WantedBy=multi-user.target
