# Copy to /etc/sac006/resource.env with mode 0600; fill blanks privately.
SOLANA_RPC_URL=
SAC006_BEARER_TOKEN=
# Independent merchant credential (32 random bytes, base64url). Blank disables merchant actions.
# Keep private; never include in public config, URLs, frontend assets or payer sessions.
SAC006_MERCHANT_TOKEN=
SAC006_DEPLOYMENT_RECORD_PATH=/opt/svm-auth-capture/docs/evidence/sac-007/deployment-identity.v1.json
SAC006_FACILITATOR_URL=http://127.0.0.1:8787
SAC006_FEE_PAYER=
SAC006_SERVER_KEYPAIR_PATH=/etc/sac006/keys/merchant.json
SAC006_STORE_DIR=/var/lib/sac006/operation-store
SAC006_ASSET_MINT=
# Restaurant budget is fixed in application policy: 100000000 base units.
# Demo-only deadlines: 150 seconds capture; 180 seconds refund from offer.
SAC006_PUBLIC_ORIGIN=https://capture402.xyz
SAC006_HOST=127.0.0.1
SAC006_RESOURCE_PORT=8788
