# Copy to /etc/sac006/facilitator.env with mode 0600; fill blanks privately.
# Shell/systemd-compatible assignments, no variable interpolation; quote secret values.
SOLANA_RPC_URL=
SAC006_BEARER_TOKEN=
SAC006_DEPLOYMENT_RECORD_PATH=/opt/svm-auth-capture/docs/evidence/sac-007/deployment-identity.v1.json
SAC006_FACILITATOR_KEYPAIR_PATH=/etc/sac006/keys/sponsor.json
SAC006_FACILITATOR_JOURNAL_DIR=/var/lib/sac006/facilitator-journal
SAC006_ALLOWLIST_MERCHANT=
SAC006_ALLOWLIST_MINT=
SAC006_HOST=127.0.0.1
SAC006_PORT=8787
SAC006_SPONSOR_MAX_ATTEMPTS=50
SAC006_SPONSOR_MIN_LAMPORTS=10000000
