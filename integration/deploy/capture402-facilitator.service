[Unit]
Description=Capture402 private Solana facilitator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sac006
Group=sac006
WorkingDirectory=/opt/capture402/current/integration
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/sac006/facilitator.env
ExecStart=/usr/bin/env node --experimental-strip-types src/devnet-server.ts
Restart=no
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sac006

[Install]
WantedBy=multi-user.target
